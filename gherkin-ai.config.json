{
  "projectName": "transactional-system-java-vue",
  "architecture": "monolith",
  "stack": {
    "language": "java",
    "framework": "spring-boot",
    "orm": "hibernate",
    "database": "mysql",
    "validation": "jakarta-validation",
    "auth": "jwt-bcrypt",
    "messaging": "none",
    "testing": "junit"
  },
  "rules": {
    "bcryptCostFactor": 12,
    "jwtTtlSeconds": 3600,
    "strictLayerBoundaries": true,
    "coverageTarget": 85
  },
  "outputDir": "./generated-specs",
  "frontendStack": {
    "framework": "vue",
    "language": "typescript"
  }
}
